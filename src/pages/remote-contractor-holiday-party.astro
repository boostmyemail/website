---
import Layout from '../layouts/Layout.astro';

const checkoutUrl = 'https://link.waveapps.com/n83we7-duhvrn';
const ctaLabel = 'Get your ticket — $75';

const evening = [
  'A two-hour block at Top Golf',
  'Food and soft drinks, covered',
  'A small gift',
  'A night with friends',
];

const included = [
  {
    title: 'Two hours at Top Golf',
    body: 'Your ticket includes a two-hour block.',
  },
  {
    title: 'Food and soft drinks',
    body: 'Both are covered.',
  },
  {
    title: 'A small gift',
    body: 'A little gift is part of the night.',
  },
  {
    title: 'Alcohol is not included',
    body: 'If you want an alcoholic drink, that is at your own expense.',
  },
];
---

<Layout
  title="Remote/Contractor Holiday Party at Top Golf — Boost My Email"
  description="Have your own holiday party at Top Golf and spend it with friends. Especially for remote workers and contractors, and open to anybody. Date to be decided. Tickets are $75 USD."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <span class="eyebrow">Holiday party</span>
        <h1>Remote/Contractor Holiday Party at Top Golf</h1>
        <p class="subhead">Have your own holiday party, and come spend it with us.</p>
        <p class="date-note">
          <strong>Date</strong>
          <span>To be decided</span>
        </p>
        <p class="support">
          Holidays are best spent with people. Friends in the room, a little fun, and a memory that is yours.
        </p>
        <p class="support">
          Remote workers and contractors often miss a holiday party because coworkers and clients are far away. You pay your own way for this one. It is a night with friends, a little fun, a small gift, and a holiday memory you make yourself.
        </p>
      </div>

      <aside class="evening" aria-label="The evening">
        <p class="evening-kicker">The evening</p>
        <ul>
          {evening.map(item => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="evening-date">Date to be decided</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Come as a friend</span>
      <h2>A holiday memory, spent with people.</h2>
      <p class="prose">
        The good part of the season is being with other people. This night is a chance to do that on purpose: show up, spend the time together, and make a holiday memory of your own.
      </p>
      <p class="prose">
        Have your own holiday party. Come spend it with us.
      </p>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      <span class="eyebrow">What’s included</span>
      <h2>What the night covers.</h2>
      <p class="section-intro">
        Your ticket includes two hours at Top Golf, food, soft drinks, and a small gift.
      </p>
      <div class="included">
        {included.map(item => (
          <article class="included-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Who it’s for</span>
      <h2>Made for this kind of work. Open to anybody.</h2>
      <div class="welcome">
        <article class="welcome-card welcome-card-accent">
          <h3>Contractors and remote workers</h3>
          <p>
            Designed especially for you, when coworkers and clients are too far away for their party.
          </p>
        </article>
        <article class="welcome-card">
          <h3>Anybody who wants to come</h3>
          <p>
            Friends, a little fun, and a holiday memory. If you want to be there, you are welcome.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container container-narrow">
      <span class="eyebrow eyebrow-center">Your ticket</span>
      <h2>Come spend it with us.</h2>
      <p class="date-note date-note-center">
        <strong>Date</strong>
        <span>To be decided</span>
      </p>
      <p class="closing-copy">
        A ticket is $75&nbsp;USD, and you pay your own way. One payment covers one ticket. Checkout is on Wave, so your card details stay there.
      </p>
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary btn-large"
      >
        {ctaLabel}
      </a>
      <p class="fine">
        Alcohol is not included. Opens Wave checkout.
      </p>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 32px;
  }

  .container-narrow {
    max-width: 720px;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 16px;
  }

  .eyebrow-center {
    text-align: center;
  }

  .hero {
    padding: 104px 0 96px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: center;
    gap: 64px;
  }

  h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    max-width: 680px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .subhead {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.82);
    max-width: 560px;
    line-height: 1.45;
    margin-bottom: 22px;
    text-wrap: pretty;
  }

  .date-note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 14px;
    line-height: 1.2;
  }

  .date-note strong {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: var(--r-pill);
    padding: 6px 10px;
  }

  .date-note-center {
    margin-bottom: 20px;
  }

  .support {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    line-height: 1.65;
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .support:last-child {
    margin-bottom: 0;
  }

  .evening {
    background: rgba(161, 1, 0, 0.12);
    border: 1px solid rgba(161, 1, 0, 0.40);
    border-radius: var(--r-xl);
    padding: 28px 24px 22px;
    box-shadow: var(--shadow-card);
  }

  .evening-kicker,
  .evening-date {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .evening-kicker {
    margin-bottom: 18px;
  }

  .evening ul {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .evening li {
    position: relative;
    padding-left: 18px;
    font-size: 16px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.86);
  }

  .evening li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .evening-date {
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.05em;
  }

  .section {
    padding: 88px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-tinted {
    background: rgba(255, 255, 255, 0.025);
  }

  .section h2,
  .closing h2 {
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.015em;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .section-intro {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.60);
    max-width: 560px;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .prose {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.65;
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .prose:last-child {
    margin-bottom: 0;
  }

  .included,
  .welcome {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .included-card,
  .welcome-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--r-lg);
    padding: 28px 24px;
  }

  .included-card h3,
  .welcome-card h3 {
    font-size: 18px;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .included-card p,
  .welcome-card p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin: 0;
  }

  .welcome-card-accent {
    background: rgba(161, 1, 0, 0.12);
    border-color: rgba(161, 1, 0, 0.35);
  }

  .closing {
    background: rgba(161, 1, 0, 0.10);
    border-top: 1px solid rgba(161, 1, 0, 0.25);
    padding: 88px 0 96px;
    text-align: center;
  }

  .closing h2 {
    margin-bottom: 16px;
  }

  .closing-copy {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.68);
    margin: 0 auto 28px;
    max-width: 520px;
    line-height: 1.6;
  }

  .fine {
    margin: 16px auto 0;
    max-width: 420px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.45);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: background .15s ease, transform .1s ease;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .btn-large {
    padding: 16px 32px;
    font-size: 16px;
  }

  @media (max-width: 880px) {
    .hero {
      padding: 64px 0 72px;
    }

    .hero-grid,
    .included,
    .welcome {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 720px) {
    .container {
      padding: 0 20px;
    }

    .section {
      padding: 56px 0;
    }

    .closing {
      padding: 64px 0 72px;
    }

    .date-note {
      max-width: 100%;
    }

    .btn-large {
      width: 100%;
    }
  }
</style>
