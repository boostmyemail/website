---
import { testimonials } from '../data/testimonials';
---

<section class="testimonials">
  <div class="inner">
    <div class="header">
      <span class="eyebrow">What clients say</span>
      <h2>Senior operators trust the work.</h2>
    </div>
    <div class="carousel" id="testimonial-carousel">
      <div class="track" id="testimonial-track">
        {testimonials.map(t => (
          <figure class="card">
            <blockquote>
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption>
              <span class="name">{t.name}</span>
              <span class="role">{t.title}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="controls">
        <button type="button" class="nav prev" id="testimonial-prev" aria-label="Previous testimonial">&larr;</button>
        <button type="button" class="nav next" id="testimonial-next" aria-label="Next testimonial">&rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 0 32px 96px;
  }

  .inner {
    max-width: var(--width-page);
    margin: 0 auto;
  }

  .header {
    margin-bottom: 36px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 14px;
  }

  h2 {
    font-size: clamp(28px, 3vw, 36px);
    letter-spacing: -0.01em;
    max-width: 620px;
  }

  .carousel {
    position: relative;
  }

  .track {
    display: flex;
    gap: 20px;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  .card {
    background: rgba(161,1,0,0.12);
    border-left: 2px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 26px 26px 24px;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - 40px) / 3);
    min-width: 0;
    height: 260px;
  }

  blockquote {
    font-style: italic;
    color: rgba(255,255,255,0.82);
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 22px 0;
    flex: 1;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    overflow: hidden;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-size: 14px;
    color: #fff;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .role {
    font-size: 11px;
    color: rgba(255,255,255,0.45);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 24px;
  }

  .nav {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.03);
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .nav:hover {
    border-color: var(--accent);
    background: rgba(161,1,0,0.14);
  }

  @media (max-width: 960px) {
    .card {
      flex: 0 0 calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 760px) {
    .card {
      flex: 0 0 100%;
      height: auto;
      min-height: 220px;
    }

    .header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  function initTestimonialCarousel() {
    const carousel = document.getElementById('testimonial-carousel');
    if (!carousel) return;

    const track = document.getElementById('testimonial-track') as HTMLElement;
    const prevBtn = document.getElementById('testimonial-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('testimonial-next') as HTMLButtonElement;
    const cards = Array.from(track.children) as HTMLElement[];
    const total = cards.length;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function step() {
      const card = cards[0];
      const gap = parseFloat(getComputedStyle(track).gap || '20');
      return card.getBoundingClientRect().width + gap;
    }

    function goTo(i: number) {
      index = ((i % total) + total) % total;
      track.scrollTo({ left: index * step(), behavior: 'smooth' });
    }

    function next() {
      goTo(index + 1);
    }

    function prev() {
      goTo(index - 1);
    }

    function startAutoplay() {
      stopAutoplay();
      timer = setInterval(next, 5000);
    }

    function stopAutoplay() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    nextBtn.addEventListener('click', () => {
      next();
      startAutoplay();
    });

    prevBtn.addEventListener('click', () => {
      prev();
      startAutoplay();
    });

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);

    window.addEventListener('resize', () => goTo(index));

    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonialCarousel);
  } else {
    initTestimonialCarousel();
  }
</script>
