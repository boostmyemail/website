---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  jsonLd?: object[];
}

const {
  title,
  description = "Boost My Email is a fractional lifecycle email marketing service for B2B SaaS and PLG companies, led by Michael Roberts.",
  ogType,
  image,
  jsonLd = [],
} = Astro.props;

// Sitewide entities. Pages add their own objects through the jsonLd prop.
// sameAs is omitted until the owner supplies real profile URLs.
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://boostmyemail.com/#organization',
    name: 'Boost My Email',
    url: 'https://boostmyemail.com/',
    logo: 'https://boostmyemail.com/assets/boostmyemail-logo.png',
    founder: { '@id': 'https://boostmyemail.com/about/#michael-roberts' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://boostmyemail.com/#website',
    name: 'Boost My Email',
    url: 'https://boostmyemail.com/',
    publisher: { '@id': 'https://boostmyemail.com/#organization' },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}assets/boostmyemail-logo.png`} />
    <SeoHead title={title} description={description} ogType={ogType} image={image} jsonLd={[...siteJsonLd, ...jsonLd]} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-208CGGPJNF" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-208CGGPJNF');
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline type="text/javascript">
      (function() {
        var t = document.createElement('script'),
            s = document.getElementsByTagName('script')[0];
        t.async = true;
        t.id    = 'cio-forms-handler';
        t.setAttribute('data-site-id', 'db19cb6ad3ab7366c915');
        t.setAttribute('data-base-url', 'https://customerioforms.com');

        t.src = 'https://customerioforms.com/assets/forms.js';

        s.parentNode.insertBefore(t, s);
      })();
    </script>
  </body>
</html>
