---
import Layout from '../layouts/Layout.astro';

const checkoutUrl = 'https://link.waveapps.com/n83we7-duhvrn';
const ctaLabel = 'Get your ticket — $75';

const included = [
  {
    title: 'Two hours at Top Golf',
    body: 'Your ticket includes a two-hour block.',
  },
  {
    title: 'Food and soft drinks',
    body: 'Both are covered.',
  },
  {
    title: 'A small gift',
    body: 'A little gift is part of the night.',
  },
  {
    title: 'Alcohol is not included',
    body: 'If you want an alcoholic drink, that is at your own expense.',
  },
];
---

<Layout
  title="Remote/Contractor Holiday Party at Top Golf — Boost My Email"
  description="Have your own holiday party at Top Golf and spend it with friends. Especially for remote workers and contractors, and open to anybody. Date to be decided. Tickets are $75 USD."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <span class="eyebrow">Holiday party</span>
        <h1>Remote/Contractor Holiday Party at Top Golf</h1>
        <p class="subhead">Have your own holiday party, and come spend it with us.</p>
        <p class="date-note">
          <strong>Date</strong>
          <span>To be decided</span>
        </p>
        <p class="support">
          Holidays are best spent with people. Friends in the room, a little fun, and a memory that is yours.
        </p>
        <p class="support">
          Remote workers and contractors often miss a holiday party because coworkers and clients are far away. You pay your own way for this one. It is a night with friends, a little fun, a small gift, and a holiday memory you make yourself.
        </p>
      </div>

      <aside class="included-panel" aria-labelledby="included-heading">
        <span class="eyebrow">What’s included</span>
        <h2 id="included-heading">What the night covers.</h2>
        <p class="included-intro">
          Your ticket includes two hours at Top Golf, food, soft drinks, and a small gift.
        </p>
        <div class="included">
          {included.map(item => (
            <article class="included-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Who it’s for</span>
      <h2>Remote workers, contractors, and anybody who wants to come.</h2>
      <p class="prose">
        Come spend an evening with us if you work remotely or on contract, or if you simply want to be there. Everyone is welcome.
      </p>
    </div>
  </section>

  <section class="closing">
    <div class="container container-narrow">
      <span class="eyebrow eyebrow-center">Your ticket</span>
      <h2>Come spend it with us.</h2>
      <p class="date-note date-note-center">
        <strong>Date</strong>
        <span>To be decided</span>
      </p>
      <p class="closing-copy">
        A ticket is $75&nbsp;USD, and you pay your own way. One payment covers one ticket. Checkout is on Wave, so your card details stay there.
      </p>
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary btn-large"
      >
        {ctaLabel}
      </a>
      <p class="fine">Opens Wave checkout.</p>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 32px;
  }

  .container-narrow {
    max-width: 720px;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 16px;
  }

  .eyebrow-center {
    text-align: center;
  }

  .hero {
    padding: 104px 0 96px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 440px);
    align-items: start;
    gap: 48px;
  }

  h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    max-width: 680px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .subhead {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.82);
    max-width: 560px;
    line-height: 1.45;
    margin-bottom: 22px;
    text-wrap: pretty;
  }

  .date-note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 14px;
    line-height: 1.2;
  }

  .date-note strong {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: var(--r-pill);
    padding: 6px 10px;
  }

  .date-note-center {
    margin-bottom: 20px;
  }

  .support {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    line-height: 1.65;
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .support:last-child {
    margin-bottom: 0;
  }

  .included-panel {
    background: rgba(161, 1, 0, 0.12);
    border: 1px solid rgba(161, 1, 0, 0.55);
    border-radius: var(--r-xl);
    padding: 28px 24px 24px;
    box-shadow: var(--shadow-card);
  }

  .included-panel .eyebrow {
    margin-bottom: 12px;
  }

  .included-panel h2 {
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.015em;
    margin-bottom: 12px;
    text-wrap: balance;
  }

  .included-intro {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .included {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .included-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--r-lg);
    padding: 14px 16px 12px;
  }

  .included-card h3 {
    font-size: 16px;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .included-card p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.5;
    margin: 0;
  }

  .section {
    padding: 88px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section h2,
  .closing h2 {
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.015em;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .prose {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  .closing {
    background: rgba(161, 1, 0, 0.10);
    border-top: 1px solid rgba(161, 1, 0, 0.25);
    padding: 88px 0 96px;
    text-align: center;
  }

  .closing h2 {
    margin-bottom: 16px;
  }

  .closing-copy {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.68);
    margin: 0 auto 28px;
    max-width: 520px;
    line-height: 1.6;
  }

  .fine {
    margin: 16px auto 0;
    max-width: 420px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.45);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: background .15s ease, transform .1s ease;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .btn-large {
    padding: 16px 32px;
    font-size: 16px;
  }

  @media (max-width: 880px) {
    .hero {
      padding: 64px 0 72px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 720px) {
    .container {
      padding: 0 20px;
    }

    .section {
      padding: 56px 0;
    }

    .closing {
      padding: 64px 0 72px;
    }

    .date-note {
      max-width: 100%;
    }

    .btn-large {
      width: 100%;
    }
  }
</style>
