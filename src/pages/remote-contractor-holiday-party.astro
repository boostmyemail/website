---
import Layout from '../layouts/Layout.astro';

const checkoutUrl = 'https://link.waveapps.com/n83we7-duhvrn';

const included = [
  {
    title: 'Two hours at Top Golf',
    body: 'A full two-hour block. Plenty of time to find your swing, lose it, and blame the club.',
  },
  {
    title: 'Food and soft drinks',
    body: 'Covered. Come hungry.',
  },
  {
    title: 'A small gift',
    body: 'A little something to take home. No white elephant drama required.',
  },
  {
    title: "Alcohol's on your own",
    body: "Want something stronger than a Sprite? The bar's right there. That part's on your tab.",
  },
];
---

<Layout
  title="Contractors Need a Holiday Party Too | Top Golf with Boost My Email"
  description="No office party? Same. Join remote workers, contractors, and anyone else who wants in for two hours of Top Golf, food, and a small gift. Tickets are $75 USD. Date coming soon."
>
  <section class="hero">
    <div class="container">
      <figure class="party-photo">
        <img
          src={`${import.meta.env.BASE_URL}assets/topgolf-party.png`}
          alt="Friends at a Top Golf night party"
          width="480"
          height="380"
        />
      </figure>

      <div class="hero-grid">
        <div class="copy">
          <span class="eyebrow">Holiday party (finally)</span>
          <h1>Contractors Need a Holiday Party Too</h1>
          <p class="subhead">You're not alone. Come have fun with a bunch of other marketers.</p>
          <p class="date-note">
            <strong>Date</strong>
            <span>To be decided (soon, we promise)</span>
          </p>
          <p class="support">
            That photo up there? That's the plan. Friends, golf balls flying in roughly the right direction, and a holiday memory that doesn't happen on a Zoom call.
          </p>
          <p class="support">
            When you work remote or on contract, the holiday party kind of skips you. Your coworkers are three time zones away and your clients are celebrating with their own people. So we're throwing our own. You buy your own ticket, show up, swing badly, eat well, and take home a little gift.
          </p>
          <a
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary btn-large"
          >
            Grab your ticket ($75)
          </a>
        </div>

        <aside class="included-panel" aria-labelledby="included-heading">
          <span class="eyebrow">What's included</span>
          <h2 id="included-heading">Here's what $75 gets you.</h2>
          <p class="included-intro">
            Two hours of Top Golf, food, soft drinks, and a small gift. Basically everything except the eggnog with a kick.
          </p>
          <div class="included">
            {included.map(item => (
              <article class="included-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Who it's for</span>
      <h2>Remote workers, contractors, and anyone who wants in.</h2>
      <p class="prose">
        If your "office" is a kitchen table and your "coworkers" are a Slack channel, this one's for you. Freelancers, contractors, remote folks, and honestly anybody who wants a fun night out. No badge, no org chart, no awkward speech from the CEO. Everyone's welcome.
      </p>
    </div>
  </section>

  <section class="closing">
    <div class="container container-narrow">
      <span class="eyebrow eyebrow-center">Your ticket</span>
      <h2>Come party with us.</h2>
      <p class="date-note date-note-center">
        <strong>Date</strong>
        <span>To be decided</span>
      </p>
      <p class="closing-copy">
        Tickets are $75&nbsp;USD. You pay your own way, and one payment covers one ticket, so bring a friend and have them grab their own. Checkout runs on Wave, so your card details stay with Wave.
      </p>
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary btn-large"
      >
        Get your ticket ($75)
      </a>
      <p class="fine">Opens Wave checkout.</p>
      <p class="fine">Alcohol's on your own. Golf, food, and good company are already in your ticket.</p>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 32px;
  }

  .container-narrow {
    max-width: 720px;
  }

  .party-photo {
    margin: 0 0 40px;
    max-width: 480px;
  }

  .party-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-xl);
  }

  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 16px;
  }

  .eyebrow-center {
    text-align: center;
  }

  .hero {
    padding: 48px 0 96px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 440px);
    align-items: start;
    gap: 48px;
  }

  h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    max-width: 680px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .subhead {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.82);
    max-width: 560px;
    line-height: 1.45;
    margin-bottom: 22px;
    text-wrap: pretty;
  }

  .date-note {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 14px;
    line-height: 1.3;
    max-width: 100%;
  }

  .date-note strong {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: var(--r-pill);
    padding: 6px 10px;
  }

  .date-note-center {
    margin-bottom: 20px;
  }

  .support {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    line-height: 1.65;
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .copy .btn-large {
    margin-top: 12px;
  }

  .included-panel {
    background: rgba(161, 1, 0, 0.12);
    border: 1px solid rgba(161, 1, 0, 0.55);
    border-radius: var(--r-xl);
    padding: 28px 24px 24px;
    box-shadow: var(--shadow-card);
  }

  .included-panel .eyebrow {
    margin-bottom: 12px;
  }

  .included-panel h2 {
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.015em;
    margin-bottom: 12px;
    text-wrap: balance;
  }

  .included-intro {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .included {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .included-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--r-lg);
    padding: 14px 16px 12px;
  }

  .included-card h3 {
    font-size: 16px;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .included-card p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.5;
    margin: 0;
  }

  .section {
    padding: 88px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section h2,
  .closing h2 {
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.015em;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .prose {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  .closing {
    background: rgba(161, 1, 0, 0.10);
    border-top: 1px solid rgba(161, 1, 0, 0.25);
    padding: 88px 0 96px;
    text-align: center;
  }

  .closing h2 {
    margin-bottom: 16px;
  }

  .closing-copy {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.68);
    margin: 0 auto 28px;
    max-width: 520px;
    line-height: 1.6;
  }

  .fine {
    margin: 16px auto 0;
    max-width: 460px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.45);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: background .15s ease, transform .1s ease;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .btn-large {
    padding: 16px 32px;
    font-size: 16px;
  }

  @media (max-width: 880px) {
    .hero {
      padding: 32px 0 72px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 720px) {
    .container {
      padding: 0 20px;
    }

    .section {
      padding: 56px 0;
    }

    .closing {
      padding: 64px 0 72px;
    }

    .date-note {
      max-width: 100%;
    }

    .btn-large {
      width: 100%;
    }
  }
</style>
